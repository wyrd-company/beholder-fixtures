{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist-exact-optional-properties",
    "rootDir": "src/contexts/exact-optional-properties",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/contexts/exact-optional-properties/**/*"]
}
