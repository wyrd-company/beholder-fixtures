{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/umd",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node10",
    "moduleDetection": "legacy",
    "allowUmdGlobalAccess": true
  },
  "include": [
    "src/umd/types/**/*.d.ts",
    "src/umd/consumers/module-consumer.ts",
    "src/umd/consumers/script-consumer.ts",
    "src/umd/consumers/umd-access-consumer.ts",
    "src/umd/consumers/bundler-global-consumer.ts"
  ]
}
