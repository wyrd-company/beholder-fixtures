{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "preserveSymlinks": false,
    "baseUrl": ".",
    "paths": {
      "#core/*": ["src/core/*"]
    }
  },
  "include": [
    "src/formats/rewrite-consumer.ts",
    "src/core/types.ts",
    "src/core/constants.ts",
    "src/core/util.ts"
  ]
}
