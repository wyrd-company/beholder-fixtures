{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "classic",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/classic",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@fixtures/jsx-runtime",
    "preserveSymlinks": false,
    "baseUrl": ".",
    "paths": {
      "@fixtures/jsx-runtime": ["src/formats/jsx-runtime"],
      "@fixtures/jsx-runtime/*": ["src/formats/jsx-runtime/*"]
    }
  },
  "include": [
    "src/core/types.ts",
    "src/core/constants.ts",
    "src/core/util.ts",
    "src/core/index.ts",
    "src/core/consumer-extensionless.ts",
    "src/graph/shared-types.ts",
    "src/graph/node-a.ts",
    "src/graph/node-b.ts",
    "src/formats/component.tsx",
    "src/formats/jsx.d.ts",
    "src/formats/legacy.cts",
    "src/formats/decl-shapes.d.ts",
    "src/formats/legacy-decl.d.cts",
    "src/identity/real/**/*",
    "src/identity/vendor-v1/**/*",
    "src/identity/vendor-v2/**/*",
    "src/identity/alias-via-real.ts",
    "src/exports/pkg/index.ts",
    "src/exports/pkg/util.ts",
    "src/exports/pkg/internal.ts",
    "src/exports/pkg/nested/**/*"
  ]
}
