<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- Publish properties are supplied on the command line for trimming / single-file / AOT contexts -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform\Platform.csproj" />
    <ProjectReference Include="..\Trimming\Trimming.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

  <!-- Plugin is intentionally NOT referenced at compile time; it is loaded via ALC at runtime -->
</Project>
