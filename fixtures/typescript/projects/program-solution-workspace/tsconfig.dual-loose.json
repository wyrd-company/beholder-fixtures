{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES5",
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "declaration": true,
    "outDir": "./dist/dual-loose",
    "rootDir": "./packages/dual",
    "lib": ["ES5"],
    "types": [],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["packages/dual/shared.ts", "packages/dual/consumer-loose.ts"],
  "files": ["packages/dual/shared.ts", "packages/dual/consumer-loose.ts"]
}
