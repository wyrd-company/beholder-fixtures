{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/bundler",
    "rootDir": ".",
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "preserveSymlinks": false,
    "baseUrl": ".",
    "paths": {
      "#formats/*": ["src/formats/*"],
      "#identity/*": ["src/identity/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/core/consumer-extensionless.ts",
    "src/formats/rewrite-consumer.ts",
    "src/identity/preserve-consumer.ts",
    "src/identity/linked/**/*"
  ]
}
