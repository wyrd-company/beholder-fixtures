{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "#internal/*": ["src/internal-alias-target/*"],
      "self-ref-pkg": ["packages/self-ref-pkg/src/index.ts"],
      "self-ref-pkg/*": ["packages/self-ref-pkg/src/*"]
    },
    "typeRoots": ["./local-types", "./node_modules/@types"],
    "types": []
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "local-packages/**/*",
    "local-types/**/*",
    "generated/**/*"
  ],
  "exclude": ["src/internal-alias/custom-conditions-workspace-consumer.ts"]
}
