{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "force",
    "outDir": "dist/detection-force",
    "rootDir": "src",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/detection/private-modules/**/*.ts",
    "src/detection/global-flip/**/*",
    "src/detection/jsx-runtime/**/*.tsx",
    "src/detection/package-type-esm/**/*",
    "src/detection/commonjs-indicator/**/*"
  ]
}
