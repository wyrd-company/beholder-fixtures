    <IsPackable>true</IsPackable>
    <PackageId>Acme.Analyzer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Wyrd Company</Authors>
    <Description>Analyzer package for CS-CAN-095 asset separation — carries analyzers asset</Description>
