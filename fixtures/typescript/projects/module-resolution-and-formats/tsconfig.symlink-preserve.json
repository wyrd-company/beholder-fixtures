{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/symlink-preserve",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "#core/*": ["src/core/*"],
      "#identity/*": ["src/identity/*"]
    }
  },
  "include": [
    "src/identity/real/**/*",
    "src/identity/alias-via-real.ts",
    "src/identity/alias-via-link.ts",
    "src/identity/preserve-consumer.ts",
    "src/identity/dual-identity-consumer.ts",
    "src/identity/symlink-spellings.ts",
    "src/identity/vendor-v1/**/*",
    "src/identity/vendor-v2/**/*",
    "src/core/types.ts",
    "src/core/constants.ts",
    "src/core/util.ts"
  ]
}
