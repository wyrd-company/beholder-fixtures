<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Custom-only alias: LibraryA is reachable exclusively via "extern alias LibraryA". -->
    <ProjectReference Include="..\Alias.LibraryA\Alias.LibraryA.csproj" Aliases="LibraryA" />
    <!-- No Aliases metadata: LibraryB keeps the default "global" reference alias and is
         reachable unaliased, like an ordinary project reference. -->
    <ProjectReference Include="..\Alias.LibraryB\Alias.LibraryB.csproj" />
  </ItemGroup>
</Project>
