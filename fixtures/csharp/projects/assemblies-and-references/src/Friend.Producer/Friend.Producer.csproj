<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Friend.Producer.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Friend.Consumer" Key="$(FriendProducerPublicKey)" />
  </ItemGroup>
  <PropertyGroup>
    <!-- PublicKey for Friend.Consumer when producer is strong-named -->
    <FriendProducerPublicKey></FriendProducerPublicKey>
  </PropertyGroup>
</Project>
