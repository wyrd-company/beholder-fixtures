{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "outDir": "dist/skip-default-lib-check",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": true
  },
  "include": ["src/lib/skip-default-lib-check-consumer.ts", "src/common/**/*"]
}
