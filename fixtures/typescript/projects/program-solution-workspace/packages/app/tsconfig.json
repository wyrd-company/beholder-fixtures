{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@fixtures/shared-config/tsconfig.json",
    "../../config/base.json"
  ],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/app/.tsbuildinfo",
    "outDir": "../../dist/app",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "@alias/*": ["./src/alias/*", "./src/alias/fallback/*"],
      "@data/*": ["./src/wildcard/*"],
      "@data/special/*": ["./src/wildcard/special/*"]
    },
    "rootDirs": ["./src", "../../generated"],
    "moduleSuffixes": [".ios", ".native", ""],
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true
  },
  "include": ["src/**/*", "../../generated/**/*"],
  "references": [{ "path": "../core" }]
}
