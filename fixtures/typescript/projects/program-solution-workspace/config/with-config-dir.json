{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "outDir": "${configDir}/../dist/configDir",
    "baseUrl": "${configDir}/..",
    "paths": {
      "@generated/*": ["${configDir}/../generated/*"],
      "@alias/*": [
        "${configDir}/../packages/app/src/alias/*",
        "${configDir}/../packages/app/src/alias/fallback/*"
      ],
      "@data/*": ["${configDir}/../packages/app/src/wildcard/*"],
      "@data/special/*": ["${configDir}/../packages/app/src/wildcard/special/*"]
    }
  },
  "include": [
    "${configDir}/../generated/**/*",
    "${configDir}/../packages/app/src/alias/**/*",
    "${configDir}/../packages/app/src/platform/**/*",
    "${configDir}/../packages/app/src/platform-native/**/*",
    "${configDir}/../packages/app/src/platform-empty/**/*",
    "${configDir}/../packages/app/src/wildcard/**/*",
    "${configDir}/../packages/app/src/rootdirs/**/*",
    "${configDir}/../src/generated-consumer.ts"
  ],
  "exclude": ["${configDir}/../packages/app/src/cross-root-consumer.ts"]
}
