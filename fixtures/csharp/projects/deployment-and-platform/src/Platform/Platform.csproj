<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- Declaring runtime identifiers makes this project RID-specific rather than
         RID-agnostic, so a self-contained App publish (-r linux-x64) negotiates and
         propagates its RuntimeIdentifier into this project reference. That flows
         RID_LINUX_X64 into the conditioned source and selects the matching native asset. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <DefineConstants>$(DefineConstants);RID_LINUX_X64</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);RID_WIN_X64</DefineConstants>
  </PropertyGroup>

  <!-- Source conditioned on OS: exclude both by default, then include exactly one -->
  <ItemGroup>
    <Compile Remove="ConditionalSources/Platform.Linux.cs" />
    <Compile Remove="ConditionalSources/Platform.Windows.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Include="ConditionalSources/Platform.Linux.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Include="ConditionalSources/Platform.Windows.cs" />
  </ItemGroup>

  <!-- Native asset conditioned on operating system and architecture/runtime identifier -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="..\..\assets\native\linux-x64\libnative.so" Link="assets\native\linux-x64\libnative.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="..\..\assets\native\win-x64\native.dll" Link="assets\native\win-x64\native.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
