{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": false,
    "skipDefaultLibCheck": true,
    "outDir": "dist-skip-off"
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "local-packages/**/*",
    "local-types/**/*",
    "generated/**/*"
  ]
}
