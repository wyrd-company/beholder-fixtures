{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/app/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/rootdirs",
    "tsBuildInfoFile": "./dist/rootdirs/.tsbuildinfo",
    "rootDirs": ["./packages/app/src", "./generated"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "include": [
    "packages/app/src/rootdirs/**/*",
    "packages/app/src/cross-root-consumer.ts",
    "generated/**/*"
  ],
  "references": []
}
