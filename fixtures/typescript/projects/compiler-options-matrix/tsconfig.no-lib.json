{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noLib": true,
    "declaration": true,
    "outDir": "dist/no-lib",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/lib/no-lib-consumer.ts", "src/lib/no-lib-globals.d.ts"]
}
